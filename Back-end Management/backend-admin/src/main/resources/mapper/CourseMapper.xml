<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.admin.mapper.CourseMapper">

    <resultMap id="BaseResultMap" type="com.example.admin.entity.Course">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="name" property="name"/>
        <result column="teacher" property="teacher"/>
        <result column="room" property="room"/>
        <result column="day_of_week" property="dayOfWeek"/>
        <result column="time_slot" property="timeSlot"/>
        <result column="color" property="color"/>
        <result column="remind_enabled" property="remindEnabled"/>
        <result column="remind_minutes" property="remindMinutes"/>
        <result column="start_week" property="startWeek"/>
        <result column="end_week" property="endWeek"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT * FROM courses
        <where>
            <if test="userId != null">
                AND user_id = #{userId}
            </if>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
        </where>
        ORDER BY id DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*) FROM courses
        <where>
            <if test="userId != null">
                AND user_id = #{userId}
            </if>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
        </where>
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM courses WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.example.admin.entity.Course" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO courses (user_id, name, teacher, room, day_of_week, time_slot, color, remind_enabled, remind_minutes, start_week, end_week)
        VALUES (#{userId}, #{name}, #{teacher}, #{room}, #{dayOfWeek}, #{timeSlot}, #{color}, #{remindEnabled}, #{remindMinutes}, #{startWeek}, #{endWeek})
    </insert>

    <update id="update">
        UPDATE courses
        <set>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="name != null">name = #{name},</if>
            <if test="teacher != null">teacher = #{teacher},</if>
            <if test="room != null">room = #{room},</if>
            <if test="dayOfWeek != null">day_of_week = #{dayOfWeek},</if>
            <if test="timeSlot != null">time_slot = #{timeSlot},</if>
            <if test="color != null">color = #{color},</if>
            <if test="remindEnabled != null">remind_enabled = #{remindEnabled},</if>
            <if test="remindMinutes != null">remind_minutes = #{remindMinutes},</if>
            <if test="startWeek != null">start_week = #{startWeek},</if>
            <if test="endWeek != null">end_week = #{endWeek},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM courses WHERE id = #{id}
    </delete>
</mapper>
