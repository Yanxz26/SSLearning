.form-item {
  background: white;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  height: 200rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* ==================== 图片上传 ==================== */

.label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.label-row .form-label {
  margin-bottom: 0;
}

.label-hint {
  font-size: 24rpx;
  color: #999;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-cell {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f8f9fa;
}

.preview-img {
  width: 100%;
  height: 100%;
  display: block;
}

.img-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.55);
  color: white;
  font-size: 32rpx;
  line-height: 1;
  border-bottom-left-radius: 12rpx;
}

.img-uploading {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.55);
  color: white;
  font-size: 22rpx;
}

.add-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #d9d9d9;
  box-sizing: border-box;
}

.add-icon {
  font-size: 56rpx;
  color: #bbb;
  line-height: 1;
}

.add-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
}

.subject-picker {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.subject-item {
  padding: 12rpx 24rpx;
  background: #fff2e8;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #fa8c16;
}

.subject-item.selected {
  background: #fa8c16;
  color: white;
}

.add-subject-btn {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #999;
}

.custom-subject-input {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.subject-input {
  flex: 1;
  height: 64rpx;
  padding: 0 20rpx;
  background: #fff2e8;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #fa8c16;
}

.confirm-btn {
  padding: 0 24rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  background: #fa8c16;
  color: white;
  border-radius: 32rpx;
  font-size: 26rpx;
}

.submit-btn {
  margin-top: 40rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #fa8c16 0%, #ffa940 100%);
  border-radius: 44rpx;
  font-size: 32rpx;
  color: white;
  font-weight: 500;
}
