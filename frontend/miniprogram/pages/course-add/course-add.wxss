.form-item {
  background: white;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.time-picker {
  display: flex;
  gap: 20rpx;
}

.picker-value {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
}

.form-switch {
  transform: scale(0.8);
}

.color-picker {
  display: flex;
  gap: 24rpx;
  flex-wrap: wrap;
}

.color-item {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 4rpx solid #e8e8e8;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.color-item.selected {
  border-color: #333;
  box-shadow: 0 0 0 6rpx rgba(66, 185, 255, 0.3);
}

.submit-btn {
  margin-top: 40rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #42b9ff 0%, #64c8ff 100%);
  border-radius: 44rpx;
  font-size: 32rpx;
  color: white;
  font-weight: 500;
}
