.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 180rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: white;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
}

.filter-tabs {
  display: flex;
  gap: 16rpx;
}

.tab {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 32rpx;
  transition: all 0.3s;
}

.tab.active {
  background: #42b9ff;
  color: white;
}

.sort-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  color: #42b9ff;
  background: rgba(66, 185, 255, 0.1);
  border-radius: 32rpx;
}

.sort-icon-img {
  width: 24rpx;
  height: 24rpx;
}

.sort-icon {
  font-size: 20rpx;
}

.task-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: linear-gradient(135deg, #42b9ff 0%, #64c8ff 100%);
  padding: 32rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 600;
  color: white;
}

.stat-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.3);
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: white;
  border-radius: 16rpx;
}

.checkbox {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.check-img {
  width: 44rpx;
  height: 44rpx;
}

.task-content {
  flex: 1;
  overflow: hidden;
}

.task-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-title.completed {
  text-decoration: line-through;
  color: #999;
}

.task-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

.category-tag {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  color: white;
}

.tag-icon {
  width: 18rpx;
  height: 18rpx;
}

.deadline {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 22rpx;
}

.deadline-icon {
  width: 20rpx;
  height: 20rpx;
}

.remind-badge {
  width: 28rpx;
  height: 28rpx;
}

.remind-icon {
  width: 24rpx;
  height: 24rpx;
}

.task-actions {
  display: flex;
  gap: 12rpx;
  margin-left: 16rpx;
}

.action-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 50%;
}

.action-btn.delete {
  background: rgba(255, 77, 79, 0.1);
}

.action-img {
  width: 24rpx;
  height: 24rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx;
  background: white;
  border-radius: 16rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.add-btn {
  position: fixed;
  bottom: 180rpx;
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #42b9ff 0%, #64c8ff 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(66, 185, 255, 0.4);
}

.add-icon {
  width: 52rpx;
  height: 52rpx;
}