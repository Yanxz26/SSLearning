.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.header {
  background: linear-gradient(135deg, #42b9ff 0%, #52c41a 100%);
  padding: 60rpx 30rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.header-left {
  color: #fff;
}

.page-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
}

.course-count {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 8rpx;
}

.action-btn {
  background: rgba(255, 255, 255, 0.2);
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
}

.action-btn text {
  color: #fff;
  font-size: 24rpx;
}

.search-bar {
  margin: -20rpx 20rpx 20rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  height: 80rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
}

.search-icon {
  font-size: 32rpx;
}

.filter-tabs {
  display: flex;
  padding: 0 20rpx;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.filter-tab {
  padding: 16rpx 32rpx;
  background: #fff;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #666;
}

.filter-tab.active {
  background: #42b9ff;
  color: #fff;
}

.course-list {
  padding: 0 20rpx;
}

.course-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-left: 8rpx solid;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.course-info {
  flex: 1;
}

.course-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.course-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.course-subject {
  padding: 4rpx 12rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #666;
}

.course-detail {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.course-time {
  font-size: 24rpx;
  color: #666;
}

.course-actions {
  display: flex;
  gap: 20rpx;
}

.action-item {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 50%;
}

.action-item.delete {
  background: #fff2f0;
}

.action-icon {
  font-size: 28rpx;
}

.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  display: block;
  margin-bottom: 30rpx;
}

.add-btn {
  display: inline-block;
  padding: 20rpx 48rpx;
  background: linear-gradient(135deg, #42b9ff 0%, #52c41a 100%);
  border-radius: 40rpx;
}

.add-btn text {
  color: #fff;
  font-size: 28rpx;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 200rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #42b9ff 0%, #52c41a 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(66, 185, 255, 0.4);
}

.fab-icon {
  font-size: 56rpx;
  color: #fff;
  font-weight: 300;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 90%;
  max-height: 80vh;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  padding: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.modal-body {
  padding: 30rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item.half {
  flex: 1;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-picker {
  height: 80rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 0 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.form-picker.small {
  display: inline-block;
  padding: 16rpx 20rpx;
  height: auto;
}

.picker-arrow {
  color: #999;
  font-size: 32rpx;
}

.form-switch {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.reminder-time {
  margin-top: 16rpx;
}

.modal-footer {
  padding: 24rpx 30rpx;
  border-top: 2rpx solid #f0f0f0;
  display: flex;
  gap: 20rpx;
}

.btn-cancel, .btn-confirm {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  font-size: 30rpx;
}

.btn-cancel {
  background: #f5f5f5;
  color: #666;
}

.btn-confirm {
  background: linear-gradient(135deg, #42b9ff 0%, #52c41a 100%);
  color: #fff;
}