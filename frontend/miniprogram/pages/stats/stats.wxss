.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 180rpx;
}

.summary-cards {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.summary-card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.card-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 12rpx;
}

.card-value {
  font-size: 44rpx;
  font-weight: 600;
  color: #42b9ff;
}

.card-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.chart-section {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-icon {
  width: 32rpx;
  height: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.time-switch {
  display: flex;
  background: #f5f5f5;
  border-radius: 32rpx;
  padding: 4rpx;
}

.switch-btn {
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  color: #666;
  border-radius: 24rpx;
}

.switch-btn.active {
  background: #42b9ff;
  color: white;
}

.bar-chart {
  padding: 20rpx 0;
}

.chart-bars {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 200rpx;
}

.bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.bar-container {
  width: 40rpx;
  height: 160rpx;
  background: #f0f5ff;
  border-radius: 8rpx;
  display: flex;
  align-items: flex-end;
}

.bar {
  width: 100%;
  background: linear-gradient(180deg, #42b9ff 0%, #64c8ff 100%);
  border-radius: 8rpx;
  transition: height 0.3s;
}

.bar-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
}

.week-chart {
  padding: 10rpx 0;
}

.week-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 140rpx;
  margin-bottom: 16rpx;
}

.week-row:last-child {
  margin-bottom: 0;
}

.week-item .bar-container {
  width: 32rpx;
  height: 100rpx;
}

.week-item .bar-label {
  font-size: 18rpx;
  margin-top: 8rpx;
}

.week-item .bar-value {
  font-size: 16rpx;
}

.line-chart {
  height: 240rpx;
  position: relative;
}

.chart-grid {
  position: absolute;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.grid-line {
  height: 1rpx;
  background: #f0f0f0;
}

.chart-line {
  position: absolute;
  width: 100%;
  height: 100%;
}

.line-point {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: translateX(-50%);
  z-index: 10;
}

.point-dot {
  width: 16rpx;
  height: 16rpx;
  background: #42b9ff;
  border-radius: 50%;
  border: 4rpx solid white;
  box-shadow: 0 2rpx 8rpx rgba(66, 185, 255, 0.4);
}

.point-value {
  font-size: 20rpx;
  color: #42b9ff;
  margin-top: 8rpx;
}

.line-svg {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  z-index: 1;
  overflow: visible;
}

.line-path {
  fill: none;
  stroke: #42b9ff;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
  vector-effect: non-scaling-stroke;
}

.chart-labels {
  position: absolute;
  bottom: -32rpx;
  width: 100%;
  display: flex;
  justify-content: space-between;
}

.chart-label {
  font-size: 22rpx;
  color: #999;
}

.detail-section {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
}

.detail-list {
  display: flex;
  flex-direction: column;
}

.detail-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 50%;
  margin-right: 16rpx;
}

.detail-icon {
  width: 28rpx;
  height: 28rpx;
}

.detail-label {
  flex: 1;
  font-size: 28rpx;
  color: #666;
}

.detail-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}