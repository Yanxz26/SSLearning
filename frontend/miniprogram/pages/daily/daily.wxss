.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.header {
  background: #fff;
  padding: 60rpx 30rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.date-nav {
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.nav-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 50%;
  font-size: 32rpx;
  color: #666;
}

.date-info {
  text-align: center;
}

.date-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.date-weekday {
  font-size: 24rpx;
  color: #999;
}

.today-btn {
  padding: 12rpx 24rpx;
  background: #42b9ff;
  border-radius: 24rpx;
}

.today-btn text {
  color: #fff;
  font-size: 24rpx;
}

.schedule-content {
  display: flex;
  margin: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.time-axis {
  width: 120rpx;
  flex-shrink: 0;
  background: #f8f9fa;
  padding: 20rpx 0;
}

.time-item {
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #999;
  border-bottom: 2rpx solid #f0f0f0;
}

.events-area {
  flex: 1;
  padding: 20rpx;
  position: relative;
}

.event-line {
  height: 100rpx;
  border-bottom: 2rpx solid #f5f5f5;
  position: relative;
}

.event-card {
  position: absolute;
  left: 0;
  right: 0;
  top: 8rpx;
  padding: 16rpx;
  border-radius: 8rpx;
  border-left: 6rpx solid;
  margin-right: 8rpx;
}

.event-name {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.event-detail {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}